  request            PurchaseRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  variant            ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  unit               SaleUnit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  approvalLines      PurchaseApprovalLine[]

  @@index([requestId, sort])
  @@map("purchase_request_lines")
}

model PurchaseRequestAction {
  id         String          @id @default(uuid()) @db.Uuid
  requestId  String          @map("request_id") @db.Uuid
  actorId    String          @map("actor_id") @db.Uuid
  actionType String          @map("action_type")
  text       String
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor      AppUser         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("purchase_request_actions")
}

model PurchaseApproval {
  id              String                 @id @default(uuid()) @db.Uuid
  requestId       String                 @map("request_id") @db.Uuid
  actorId         String                 @map("actor_id") @db.Uuid
  outcome         String
  buyer           String?
  budgetMinor     BigInt                 @default(0) @map("budget_minor")
  sourceAccountId String?                @map("source_account_id") @db.Uuid
  validUntil      DateTime?              @map("valid_until") @db.Timestamptz(6)
  reason          String?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  request         PurchaseRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor           AppUser                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  sourceAccount   MoneyAccount?          @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)
  lines           PurchaseApprovalLine[]
  purchases       Purchase[]

  @@index([requestId, createdAt])
  @@map("purchase_approvals")
}

model PurchaseApprovalLine {
  id                   String              @id @default(uuid()) @db.Uuid
  approvalId           String              @map("approval_id") @db.Uuid
  requestLineId        String              @map("request_line_id") @db.Uuid
  maxQtyBase           Decimal             @map("max_qty_base") @db.Decimal(20, 6)
  maxAmountMinor       BigInt              @map("max_amount_minor")
  consumedQtyBase      Decimal             @default(0) @map("consumed_qty_base") @db.Decimal(20, 6)
  consumedAmountMinor  BigInt              @default(0) @map("consumed_amount_minor")
  approval             PurchaseApproval    @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  requestLine          PurchaseRequestLine @relation(fields: [requestLineId], references: [id], onDelete: Restrict)

  @@index([approvalId])
  @@map("purchase_approval_lines")
}

model Purchase {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  shopId             String?                @map("shop_id") @db.Uuid
  actorId            String                 @map("actor_id") @db.Uuid
  supplierId         String                 @map("supplier_id") @db.Uuid
  requestId          String?                @map("request_id") @db.Uuid
  approvalId         String?                @map("approval_id") @db.Uuid
  reference          String                 @unique
  status             String
  goodsMinor         BigInt                 @map("goods_minor")
  supplierFeesMinor  BigInt                 @default(0) @map("supplier_fees_minor")
  externalFeesMinor  BigInt                 @default(0) @map("external_fees_minor")
  stockValueMinor    BigInt                 @map("stock_value_minor")
  paidMinor          BigInt                 @default(0) @map("paid_minor")
  receivedStatus     String                 @default("NONE") @map("received_status")
  paymentStatus      String                 @default("DUE") @map("payment_status")
  controlStatus      String                 @default("OPEN") @map("control_status")
  dueDate            DateTime?              @map("due_date") @db.Date
  postedAt           DateTime?              @map("posted_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop               Shop?                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor              AppUser                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  supplier           Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  request            PurchaseRequest?       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  approval           PurchaseApproval?      @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  lines              PurchaseLine[]
  destinations       PurchaseDestination[]
  fees               PurchaseFee[]
  payments           PurchasePayment[]
  shipments          Shipment[]

  @@index([organizationId, status, createdAt])
  @@index([shopId, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchases")
}

model PurchaseLine {
  id                     String                 @id @default(uuid()) @db.Uuid
  purchaseId             String                 @map("purchase_id") @db.Uuid
  variantId              String                 @map("variant_id") @db.Uuid
  unitId                 String                 @map("unit_id") @db.Uuid
  quantityBase           Decimal                @map("quantity_base") @db.Decimal(20, 6)
  unitPriceMinor         BigInt                 @map("unit_price_minor")
  goodsMinor             BigInt                 @map("goods_minor")
  allocatedFeesMinor     BigInt                 @default(0) @map("allocated_fees_minor")
  allocatedExternalMinor BigInt                 @default(0) @map("allocated_external_minor")
  receivedQtyBase        Decimal                @default(0) @map("received_qty_base") @db.Decimal(20, 6)
  purchase               Purchase               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  variant                ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  unit                   SaleUnit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  destinations           PurchaseDestination[]
  shipmentLines          ShipmentLine[]

  @@index([purchaseId])
  @@map("purchase_lines")
}

model PurchaseDestination {
  id              String       @id @default(uuid()) @db.Uuid
  purchaseId      String       @map("purchase_id") @db.Uuid
  purchaseLineId  String       @map("purchase_line_id") @db.Uuid
  locationId      String       @map("location_id") @db.Uuid
  qtyBase         Decimal      @map("qty_base") @db.Decimal(20, 6)
  receivedQtyBase Decimal      @default(0) @map("received_qty_base") @db.Decimal(20, 6)
  purchase        Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  purchaseLine    PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  location        Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([locationId])
  @@map("purchase_destinations")
}

model PurchaseFee {
  id          String        @id @default(uuid()) @db.Uuid
  purchaseId  String        @map("purchase_id") @db.Uuid
  kind        String
  amountMinor BigInt        @map("amount_minor")
  accountId   String?       @map("account_id") @db.Uuid
  description String
  purchase    Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  account     MoneyAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@map("purchase_fees")
}

model PurchasePayment {
  id          String       @id @default(uuid()) @db.Uuid
  purchaseId  String       @map("purchase_id") @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  actorId     String       @map("actor_id") @db.Uuid
  sessionId   String?      @map("session_id") @db.Uuid
  amountMinor BigInt       @map("amount_minor")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  purchase    Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  account     MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actor       AppUser      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  session     CashSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([purchaseId, createdAt])
  @@map("purchase_payments")
}

model Shipment {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  sourceLocationId       String?        @map("source_location_id") @db.Uuid
  destinationLocationId  String         @map("destination_location_id") @db.Uuid
  requestId              String?        @map("request_id") @db.Uuid
  purchaseId             String?        @map("purchase_id") @db.Uuid
  actorId                String         @map("actor_id") @db.Uuid
  status                 String
  carrier                String?
  note                   String?
  dispatchedById         String?        @map("dispatched_by_id") @db.Uuid
  dispatchedAt           DateTime?      @map("dispatched_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceLocation         Location?      @relation("ShipmentSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation    Location       @relation("ShipmentDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  request                PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  purchase               Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  actor                  AppUser        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  dispatchedBy           AppUser?       @relation("ShipmentDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict)
  lines                  ShipmentLine[]
  receipts               GoodsReceipt[]

  @@index([organizationId, status, createdAt])
  @@index([destinationLocationId, status])
  @@index([sourceLocationId, status])
  @@index([purchaseId])
  @@map("shipments")
}

model ShipmentLine {
  id             String                    @id @default(uuid()) @db.Uuid
  shipmentId     String                    @map("shipment_id") @db.Uuid
  variantId      String                    @map("variant_id") @db.Uuid
  purchaseLineId String?                   @map("purchase_line_id") @db.Uuid
  requestedQty   Decimal                   @map("requested_qty") @db.Decimal(20, 6)
  dispatchedQty  Decimal                   @default(0) @map("dispatched_qty") @db.Decimal(20, 6)
  receivedQty    Decimal                   @default(0) @map("received_qty") @db.Decimal(20, 6)
  shipment       Shipment                  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  variant        ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseLine   PurchaseLine?             @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  allocations    ShipmentCostAllocation[]
  receiptLines   GoodsReceiptLine[]
  transitLayers  CostLayer[]

  @@index([shipmentId])
  @@map("shipment_lines")
}

model ShipmentCostAllocation {
  id                 String       @id @default(uuid()) @db.Uuid
  shipmentLineId     String       @map("shipment_line_id") @db.Uuid
  originCostLayerId  String?      @map("origin_cost_layer_id") @db.Uuid
  transitCostLayerId String       @map("transit_cost_layer_id") @db.Uuid
  qty                Decimal      @db.Decimal(20, 6)
  valueMinor         BigInt       @map("value_minor")
  shipmentLine       ShipmentLine @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict)
  originLayer        CostLayer?   @relation("OriginLayer", fields: [originCostLayerId], references: [id], onDelete: Restrict)
  transitLayer       CostLayer    @relation("TransitLayer", fields: [transitCostLayerId], references: [id], onDelete: Restrict)

  @@index([shipmentLineId])
  @@map("shipment_cost_allocations")
}

model GoodsReceipt {
  id                      String             @id @default(uuid()) @db.Uuid
  organizationId          String             @map("organization_id") @db.Uuid
  shipmentId              String             @map("shipment_id") @db.Uuid
  destinationLocationId   String             @map("destination_location_id") @db.Uuid
  receivedById            String             @map("received_by_id") @db.Uuid
  status                  String             @default("POSTED")
  deliveryComplete        Boolean            @default(false) @map("delivery_complete")
  surplusCaseId           String?            @map("surplus_case_id") @db.Uuid
  missingCaseId           String?            @map("missing_case_id") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipment                Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  destinationLocation     Location           @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict)
  receivedBy              AppUser            @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  surplusCase             DiscrepancyCase?   @relation("ReceiptSurplus", fields: [surplusCaseId], references: [id], onDelete: Restrict)
  missingCase             DiscrepancyCase?   @relation("ReceiptMissing", fields: [missingCaseId], references: [id], onDelete: Restrict)
  lines                   GoodsReceiptLine[]

  @@index([shipmentId, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String        @id @default(uuid()) @db.Uuid
  receiptId      String        @map("receipt_id") @db.Uuid
  shipmentLineId String        @map("shipment_line_id") @db.Uuid
  variantId      String        @map("variant_id") @db.Uuid
  lotId          String?       @map("lot_id") @db.Uuid
  acceptedQty    Decimal       @default(0) @map("accepted_qty") @db.Decimal(20, 6)
  damagedQty     Decimal       @default(0) @map("damaged_qty") @db.Decimal(20, 6)
  surplusQty     Decimal       @default(0) @map("surplus_qty") @db.Decimal(20, 6)
  remarks        String?
  receipt        GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  shipmentLine   ShipmentLine  @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lot            Lot?          @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@map("goods_receipt_lines")
}
