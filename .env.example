# Secrets factices réservés au Docker local. Ne pas réutiliser hors de la machine de développement.
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8080
WEB_ORIGIN=http://127.0.0.1:8080
API_PORT=4311
WEB_PORT=4310
WORKER_PORT=4312
TRUST_PROXY=0
COOKIE_SECURE=0

POSTGRES_ADMIN_URL=postgresql://cercle:local-dev-only@127.0.0.1:5432/postgres
DATABASE_URL=postgresql://cercle_app:local-app-only@127.0.0.1:5432/cercle_complet
DATABASE_MIGRATION_URL=postgresql://cercle_migrator:local-migrator-only@127.0.0.1:5432/cercle_complet
TEST_DATABASE_URL=postgresql://cercle_app:local-app-only@127.0.0.1:5432/cercle_complet_test
TEST_DATABASE_MIGRATION_URL=postgresql://cercle_migrator:local-migrator-only@127.0.0.1:5432/cercle_complet_test

BETTER_AUTH_SECRET=local-only-secret-not-for-production-32b

REDIS_URL=redis://cercle:local-redis-only@127.0.0.1:6379

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=cercle-private
S3_ACCESS_KEY=local-s3-access
S3_SECRET_KEY=local-s3-secret-not-production
